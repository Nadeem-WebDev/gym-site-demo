# ---- Client-safe values ONLY -------------------------------------------------
# Every VITE_* variable is compiled into the public JavaScript bundle and is
# readable by anyone who opens the site. Never put a private/server API secret
# here. See README "Environment variables".

# WhatsApp destination, digits only, country code first, no + and no spaces.
VITE_WHATSAPP_NUMBER=918972469383

# Optional email provider. Leave VITE_EMAIL_PROVIDER empty to disable the email
# path entirely - the form then falls back to WhatsApp and a mailto: link.
# Supported: web3forms | formspree
VITE_EMAIL_PROVIDER=

# web3forms: the public "access key" from https://web3forms.com (client-safe).
VITE_WEB3FORMS_KEY=

# formspree: the form id from https://formspree.io, e.g. xayzbqwe (client-safe).
VITE_FORMSPREE_ID=
